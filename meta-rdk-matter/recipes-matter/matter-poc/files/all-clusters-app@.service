[Unit]
Description=Matter All Clusters App POC Instance (%i)
After=network-online.target otbr-agent.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/matter/poc.env
ExecStart=/usr/bin/all-clusters-app --wifi --thread --ble-device 0 --KVS ${MATTER_STORAGE_DIR:-/var/lib/matter}/allclusters-%i
Restart=on-failure

[Install]
WantedBy=matter-demo.target
