# Matter POC environment (example defaults, can be overridden at runtime)
# Primary backhaul interface for IPv4/IPv6 and routing
MATTER_PRIMARY_IFACE=eth0
# Thread interface name for OTBR and Thread commissioning
MATTER_THREAD_IFACE=wpan0
# Optional: PAA trust store path if installed by Matter recipes
MATTER_PAA_TRUST_STORE=/usr/share/matter/credentials/PAI
# Persistent storage directory for chip-tool and example apps
MATTER_STORAGE_DIR=/var/lib/matter
# Mark this as POC only (no production security)
MATTER_COMMISSIONING_EXAMPLE_ONLY=1
