# Yocto/OE environment example for kirkstone-7931
# Copy this file to ".env" and adjust values for your environment.
# Do not commit your local .env file.

# Machine and distro selection
YOCTO_MACHINE=raspberrypi4-64
YOCTO_DISTRO=rdk

# Number of parallel build jobs (default to CPU count if unset)
BB_NUMBER_THREADS=0
PARALLEL_MAKE=-j0

# Download and sstate mirrors (optional)
# DL_DIR=/home/yocto/downloads
# SSTATE_DIR=/home/yocto/sstate-cache
# SSTATE_MIRRORS= "file://.* http://sstate.example.com/PATH;downloadfilename=PATH"

# Git proxy (optional)
# GIT_PROXY_COMMAND=

# SDK options (optional)
# SDKMACHINE=x86_64

# Extra layers path hint (optional)
# EXTRA_LAYERS=/home/yocto/layers

# Note:
# - Values of 0 for BB_NUMBER_THREADS and -j0 will be interpreted by setup scripts
#   as "use the number of available CPUs". If your build scripts don't override these,
#   set explicit numbers like BB_NUMBER_THREADS=8 and PARALLEL_MAKE="-j8".
# - This file is for developer convenience only; CI may inject its own environment.
