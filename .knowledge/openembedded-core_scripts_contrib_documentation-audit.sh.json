{"is_source_file": true, "format": "bash shell script", "description": "This script performs an audit of package documentation within a build environment, specifically targeting packages built with bitbake. It searches for documentation packages associated with each build recipe, reports missing documentation, and logs build errors. The script is used in the context of Yocto-based build systems to verify documentation inclusion for different packages.", "external_files": ["bitbake", "build environment scripts"], "external_methods": ["which bitbake", "bitbake -s", "bitbake -e <package>"], "published": [], "classes": [], "methods": [], "calls": ["which bitbake", "bitbake -s", "bitbake -e $pkg", "awk '{ print $1 }'", "find $WORKDIR/packages-split/*-doc -maxdepth 0 -type d", "find $FIND_DOC_PKG -type f"], "search-terms": ["documentation audit", "bitbake", "package documentation", "build environment script", "qemux86 build", "yocto", "package -doc", "build errors", "documentation packages"], "state": 2, "file_id": 2899, "knowledge_revision": 29554, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "09a0b02fd7b67f263bf6d5ca69813dfc", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "openembedded-core/scripts/contrib/documentation-audit.sh", "revision_history": [{"29554": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}