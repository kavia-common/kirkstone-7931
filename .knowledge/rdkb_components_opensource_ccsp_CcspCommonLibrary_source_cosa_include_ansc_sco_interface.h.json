et the connector to its initial state."}, {"name": "AcquirePdo", "description": "Function pointer to acquire a packet descriptor object."}, {"name": "ReleasePdo", "description": "Function pointer to release a packet descriptor object."}, {"name": "Open", "description": "Function pointer to open the connector."}, {"name": "Close", "description": "Function pointer to close the connector."}, {"name": "AsyncRelayTask", "description": "Function pointer to start the asynchronous relay task."}, {"name": "Relay", "description": "Function pointer to relay data packets."}], "calls": ["ansc_co_interface.h", "ansc_co_external_api.h", "ansc_scopo_interface.h"], "search-terms": ["Simplex Connector", "ANSC_SCO", "Packet Descriptor", "Platform Independent Interface", "Relay Function", "Connection Ports"], "state": 2, "file_id": 7442, "knowledge_revision": 34101, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "ACCESS_ANSC_SCO_PACKET_DESCRIPTOR", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/cosa/include/ansc_sco_interface.h", "pattern": "/^#define  ACCESS_ANSC_SCO_PACKET_DESCRIPTOR(/", "language": "C++", "kind": "macro", "signature": "(p)"}, {"_type": "tag", "name": "ACCESS_ANSC_SIMPLEX_CONNECTOR_OBJECT", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/cosa/include/ansc_sco_interface.h", "pattern": "/^#define  ACCESS_ANSC_SIMPLEX_CONNECTOR_OBJECT(/", "language": "C++", "kind": "macro", "signature": "(p)"}, {"_type": "tag", "name": "ANSC_SCO_MAX_PDO_POOL_SIZE", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/cosa/include/ansc_sco_interface.h", "pattern": "/^#define  ANSC_SCO_MAX_PDO_POOL_SIZE /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "ANSC_SCO_MIN_PDO_POOL_SIZE", "path": "/home/kavia/workspace/code-gen