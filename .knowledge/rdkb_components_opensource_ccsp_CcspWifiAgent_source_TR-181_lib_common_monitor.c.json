{"is_source_file": true, "format": "C", "description": "This file is a C source code implementation of a process monitoring system. It manages process supervision, signals handling, counters to detect deadlocks or hangs, and process restarts upon failure. It implements a parent-child process monitor architecture and includes signal handling for crashes and termination.", "external_files": ["log.h", "os.h", "os_time.h", "osa_assert.h", "monitor.h"], "external_methods": ["task_name_get", "task_name_set", "ticks", "backtrace_dump", "strsignal"], "published": ["mon_checkin"], "classes": [], "methods": [{"name": "void mon_start(int argc,char * argv[])", "description": "Starts the process monitor, forks a child process, installs signal handlers, and manages process lifecycle including restart logic.", "scope": "", "scopeKind": ""}, {"name": "bool mon_process_wait(pid_t child,ticks_t timeout)", "description": "Waits for a process or process group to terminate within a specified timeout period, reaping any zombie processes.", "scope": "", "scopeKind": ""}, {"name": "void mon_process_terminate(pid_t child)", "description": "Attempts to terminate a process or process group gracefully with SIGTERM, escalating to SIGKILL if necessary.", "scope": "", "scopeKind": ""}, {"name": "bool mon_check_process(pid_t child,int * exit_status)", "description": "Checks if a child process is still alive, and if it has exited, determines the reason and sets the appropriate exit status.", "scope": "", "scopeKind": ""}, {"name": "bool mon_check_counter(pid_t child,int * exit_status)", "description": "Verifies if counters indicating process responsiveness have been updated recently; if not, sends SIGABRT to the process or thread.", "scope": "", "scopeKind": ""}, {"name": "void mon_counter_reset(void)", "description": "Allocates and resets shared memory for process counters used for liveness detection.", "scope": "", "scopeKind": ""}, {"name": "void mon_install_parent_signals(void)", "description": "Installs signal handlers for parent process signals to handle termination and forwarding signals to child.", "scope": "", "scopeKind": ""}, {"name": "void mon_reset_parent_signals(void)", "description": "Resets parent process signal handlers to default ones.", "scope": "", "scopeKind": ""}, {"name": "void mon_install_child_signals(void)", "description": "Sets up signal handlers for the child process to handle crashes and critical signals.", "scope": "", "scopeKind": ""}, {"name": "void mon_sig_crash(int signum)", "description": "Handles crash signals by dumping backtrace and re-raising the signal to crash appropriately.", "scope": "", "scopeKind": ""}, {"name": "void mon_sig_forward(int signum)", "description": "Forwards termination signals like SIGINT and SIGTERM to the monitored child process.", "scope": "", "scopeKind": ""}, {"name": "void mon_sig_str(int signum,char * sigstr,size_t sigstr_sz)", "description": "Provides a human-readable string description for signal numbers.", "scope": "", "scopeKind": ""}, {"name": "void mon_checkin(enum mon_cnt_id id,char * file,int line)", "description": "Increments a specified counter to signal activity or health status, recording source file, line, and thread ID.", "scope": "", "scopeKind": ""}], "calls": ["waitpid", "kill", "sigaction", "raise", "strsignal", "memset", "snprintf", "assert", "getenv", "task_name_get", "task_name_set", "ticks", "backtrace_dump"], "search-terms": ["monitor", "process supervision", "signal handling", "child process", "counter watchdog", "restart", "shared memory", "monitor counters", "process check-in", "crash handler"], "state": 2, "file_id": 10077, "knowledge_revision": 36735, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "MON_CHECKIN", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspWifiAgent/source/TR-181/lib/common/monitor.c", "pattern": "/^#define MON_CHECKIN(/", "file": true, "language": "