{"is_source_file": true, "format": "shell script", "description": "Script for restarting 5G hotspot and managing related network interfaces and services, including stopping processes, reloading kernel modules, and toggling interfaces based on configuration and hotspot enable status.", "external_files": ["/nvram/hostapd1.conf", "/nvram/hostapd4.conf", "/nvram/hostapd0.conf", "/lib/rdk/handle_emu_gre.sh"], "external_methods": ["ps", "grep", "head", "cut", "awk", "xargs", "kill", "sleep", "rmmod", "modprobe", "ifconfig", "hostapd", "dmcli"], "published": [], "classes": [], "methods": [], "calls": ["ps -eaf", "grep hostapd5", "grep -v grep", "awk '{print $2}'", "xargs kill -9", "sleep 2", "grep hostapd1", "rmmod rtl8812au", "sleep 1", "modprobe rtl8812au", "sleep 1", "modprobe 88x2bu", "sleep 2", "ifconfig $INTERFACE_5G down", "sleep 3", "ifconfig $INTERFACE_5G up", "hostapd -B /nvram/hostapd5.conf", "sleep 2", "hostapd -B /nvram/hostapd1.conf", "dmcli simu getv Device.DeviceInfo.X_COMCAST_COM_xfinitywifiEnable", "grep value", "cut -f3 -d :", "cut -f2 -d \" \"", "cat /nvram/hostapd4.conf", "grep -w interface", "head -1", "cut -d '=' -f2", "cat /nvram/hostapd5.conf", "cat /nvram/hostapd0.conf", "grep -w bss", "cut -d '=' -f2", "cut -c1", "[ \"$HOTSPOT_ENABLE\" = \"true\" ]", "/lib/rdk/handle_emu_gre.sh create", "echo \"CCSP-HOTSPOT IS SUCCESSFULLY RUNNING\"", "if [ \"$DONGLE_INDENTIFICATION\" == \"#\" ]", "ifconfig $VIRTUAL_INTERFACE_2G down", "ifconfig $PUBLIC_INTERFACE_5G down", "else", "ifconfig $PUBLIC_INTERFACE_2G down", "ifconfig $PUBLIC_INTERFACE_5G down"], "search-terms": ["hotspot_restart_5G", "hostapd", "nvram", "interface", "handle_emu_gre"], "state": 2, "file_id": 12334, "knowledge_revision": 38991, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "27857a3590f6904f23202a232d3ff91d", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/CcspLMLite/devices/scripts/Hotspot/hotspot_restart_5G.sh",