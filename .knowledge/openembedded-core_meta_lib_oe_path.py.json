{"is_source_file": true, "format": "Python", "description": "This file contains utility functions for manipulating filesystem paths, including joining paths, determining relative paths, replacing absolute symlinks with relative ones, copying directory trees with hard links or copies, removing files and directories, creating symlinks, walking directories, resolving real paths considering symlinks, and path canonicalization. The functions support modification and analysis of filesystem structures, likely used internally within a build system or higher-level application.", "external_files": ["errno", "glob", "shutil", "subprocess", "os.path"], "external_methods": ["os.path.normpath", "os.path.relpath", "os.readlink", "os.unlink", "os.islink", "os.path.isdir", "os.path.abspath", "os.access", "glob.glob", "shutil.copy", "os.link", "os.remove", "os.symlink", "os.walk", "os.path.join", "os.path.realpath", "os.getcwd", "os.rmdir", "os.path.sep", "os.path.exists"], "published": ["join", "relative", "make_relative_symlink", "replace_absolute_symlinks", "format_display", "copytree", "copyhardlinktree", "copyhardlink", "remove", "symlink", "find", "realpath", "is_path_parent", "which_wild", "canonicalize"], "classes": [], "methods": [{"name": "join(*paths)", "description": "Concatenates multiple path segments into a normalized path, similar to os.path.join but doesn't treat absolute RHS specially.", "scope": "", "scopeKind": ""}, {"name": "relative(src, dest)", "description": "Calculates a relative path from src to dest.", "scope": "", "scopeKind": ""}, {"name": "make_relative_symlink(path)", "description": "Converts an absolute symlink to a relative one, if applicable.", "scope": "", "scopeKind": ""}, {"name": "replace_absolute_symlinks(basedir, d)", "description": "Walks through a base directory, replacing absolute symlinks with relative ones based on the specified base directory.", "scope": "", "scopeKind": ""}, {"name": "format_display(path, metadata)", "description": "Prep