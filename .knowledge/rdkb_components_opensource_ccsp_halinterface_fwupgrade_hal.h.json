{"is_source_file": true, "format": "C/C++ Header File", "description": "This file defines the interface for the Firmware (FW) Upgrade HAL (Hardware Abstraction Layer). It contains function prototypes for setting and getting the download URL and filename, configuring download interface, initiating downloads, checking download status, rebooting, factory resetting, and installing firmware updates. The file also includes constants, type definitions, and licensing information.", "external_files": ["/tmp/httpDwnld.conf", "<sys/time.h>"], "external_methods": ["open('/tmp/httpDwnld.conf')"], "published": ["fwupgrade_hal_set_download_url", "fwupgrade_hal_get_download_url", "fwupgrade_hal_set_download_interface", "fwupgrade_hal_get_download_interface", "fwupgrade_hal_download", "fwupgrade_hal_get_download_status", "fwupgrade_hal_reboot_ready", "fwupgrade_hal_download_reboot_now", "fwupgrade_hal_update_and_factoryreset", "fwupgrade_hal_download_install"], "classes": [], "methods": [{"name": "fwupgrade_hal_set_download_url", "description": "Sets the firmware download URL and filename, specifying locations for the firmware image and related parameters."}, {"name": "fwupgrade_hal_get_download_url", "description": "Retrieves the current firmware download URL and filename."}, {"name": "fwupgrade_hal_set_download_interface", "description": "Configures the network interface used for firmware download, either wan0 or erouter0."}, {"name": "fwupgrade_hal_get_download_interface", "description": "Retrieves the current network interface used for firmware download."}, {"name": "fwupgrade_hal_download", "description": "Initiates the firmware download process."}, {"name": "fwupgrade_hal_get_download_status", "description": "Provides the status of the current firmware download, including progress and error codes."}, {"name": "fwupgrade_hal_reboot_ready", "description": "Checks whether the device is ready to reboot after firmware update."}, {"name": "fwupgrade_hal_download_reboot_now", "description": "Triggers an immediate reboot to complete firmware installation."}, {"name": "fwupgrade_hal_update_and_factoryreset", "description": "Performs firmware update and resets the device to factory settings."}, {"name": "fwupgrade_hal_download_install", "description": "Downloads and installs firmware from a specified URL."}], "calls": ["open('/tmp/httpDwnld.conf')"], "search-terms": ["fwupgrade_hal", "download_url", "firmware filename", "FW Download Interface", "reboot status", "factory reset", "firmware upgrade", "fw upgrade"], "state": 2, "file_id": 12519, "knowledge_revision": 39173, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "BOOLEAN", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/halinterface/fwupgrade_hal.h", "pattern": "/^#define BOOLEAN /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "CHAR", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/halinterface/fwupgrade_hal.h", "pattern": "/^#define CHAR /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "ENABLE", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/halinterface/fwupgrade_hal.h", "pattern": "/^#define ENABLE /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "FALSE", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/halinterface/fwupgrade_hal.h", "pattern": "/^#define FALSE /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "INT", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/halinterface/fwupgrade_hal.h", "pattern": "/^#define INT /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "LONG", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/halinterface/fwupgrade_hal.h", "pattern": "/^#define LONG\t/", "lan