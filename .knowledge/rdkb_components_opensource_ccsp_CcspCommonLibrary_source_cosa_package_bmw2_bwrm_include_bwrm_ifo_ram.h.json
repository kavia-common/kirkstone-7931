essed web page from the cache or storage."}, {"name": "ForcePageCache", "description": "Forces a cache for a specific page."}, {"name": "IsPageCacheForced", "description": "Checks if a page cache is forced."}], "calls": [], "state": 2, "file_id": 7753, "knowledge_revision": 34412, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "ACCESS_BWRM_RAM_INTERFACE", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/cosa/package/bmw2/bwrm/include/bwrm_ifo_ram.h", "pattern": "/^#define  ACCESS_BWRM_RAM_INTERFACE(/", "language": "C++", "kind": "macro", "signature": "(p)"}, {"_type": "tag", "name": "BWRM_RAM_CTRL_CODE_disable", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/cosa/package/bmw2/bwrm/include/bwrm_ifo_ram.h", "pattern": "/^#define  BWRM_RAM_CTRL_CODE_disable /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "BWRM_RAM_CTRL_CODE_enable", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/cosa/package/bmw2/bwrm/include/bwrm_ifo_ram.h", "pattern": "/^#define  BWRM_RAM_CTRL_CODE_enable /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "BWRM_RAM_CTRL_CODE_reset", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/cosa/package/bmw2/bwrm/include/bwrm_ifo_ram.h", "pattern": "/^#define  BWRM_RAM_CTRL_CODE_reset /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "BWRM_RAM_INTERFACE", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/cosa/package/bmw2/bwrm/include/bwrm_ifo_ram.h", "pattern": "/^BWRM_RAM_INTERFACE,  *PBWRM_RAM_INTERFACE;$/", "language": "C++", "typeref": "struct:_BWRM_RAM_INTERFACE", "kind": "typedef"}, {"_type": "tag", "name": "BWR