{"is_source_file": true, "format": "Shell Script", "description": "This file is a shell script responsible for starting the parodus process by constructing its command-line arguments based on device information and system state. It also manages checking the existence of a command file and waits for certain system conditions before launching the service.", "external_files": ["/tmp/parodusCmd.cmd", "/version.txt"], "external_methods": ["cat", "grep", "tr", "cut", "ifconfig", "sleep"], "published": [], "classes": [], "methods": [], "calls": ["/usr/bin/parodus", "cat /tmp/parodusCmd.cmd", "$GET com.cisco.spvtg.ccsp.pam.Health", "$GET Device.DeviceInfo.ModelName", "$GET Device.DeviceInfo.SerialNumber", "$GET Device.DeviceInfo.Manufacturer", "$GET Device.X_CISCO_COM_CableModem.MACAddress", "ifconfig eth0", "$GET Device.DeviceInfo.X_RDKCENTRAL-COM_LastRebootReason", "$GET Device.DeviceInfo.X_CISCO_COM_FirmwareName", "$GET Device.DeviceInfo.X_RDKCENTRAL-COM_BootTime", "cat /version.txt", "grep", "cut", "grep value", "tr -s ' '", "sleep"], "search-terms": ["parodus_start.sh", "parodus", "system information", "device info", "startup script", "system wait", "device health"], "state": 2, "file_id": 11574, "knowledge_revision": 38228, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "d3d7dc5cb2ac277d70fff493c234c554", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/CcspCr/devices/scripts/Webpa/parodus_start.sh", "revision_history": [{"38228": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}