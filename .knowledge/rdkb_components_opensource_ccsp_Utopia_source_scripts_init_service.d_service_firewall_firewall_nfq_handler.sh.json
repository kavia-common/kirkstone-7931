{"is_source_file": true, "format": "shell script", "description": "This script initializes and manages the NFQ handler processes for DNS and HTTP traffic in a firewall context. It sets event-based flags and starts multiple nfq_handler instances for different queues identified by system events, handling both IPv4 and IPv6 traffic. It also retrieves the MAC address of the 'brlan0' interface for use in some processing.", "external_files": ["sysevent", "ifconfig", "awk"], "external_methods": ["sysevent get", "sysevent set", "ifconfig", "grep", "awk", "seq", "echo", "sleep"], "published": [], "classes": [], "methods": [], "calls": ["sysevent get parcon_nfq_status", "sysevent set parcon_nfq_status started", "sysevent get parcon_dnsr_start", "sysevent get parcon_dnsr_end", "sysevent get parcon_httpget_start", "sysevent get parcon_httpget_end", "sysevent get parcon_dnsv6r_start", "sysevent get parcon_dnsv6r_end", "sysevent get parcon_httpv6get_start", "sysevent get parcon_httpv6get_end", "seq", "echo", "nfq_handler", "ifconfig brlan0", "grep HWaddr", "awk '{print $5}'", "sleep"], "search-terms": ["nfq_handler", "service_firewall", "firewall_nfq_handler", "parcon_nfq_status", "DNS_RESPONSE_QUEUE", "HTTP_GET_QUEUE", "nfq_handler script"], "state": 2, "file_id": 11236, "knowledge_revision": 37895, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "f9c705831c5689802686460d4326a940", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/Utopia/source/scripts/init/service.d/service_firewall/firewall_nfq_handler.sh", "revision_history": [{"37895": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}