{"is_source_file": true, "format": "JavaScript", "description": "This file is a jQuery extension script that adds custom functions to extend jQuery's capabilities, specifically for handling select (combo box) element values with improved accessibility. It defines a single method `comboVal` to get or set the value of select elements.", "external_files": ["jQuery"], "external_methods": ["jQuery.fn.val", "jQuery.fn.children", "jQuery.fn.prop", "jQuery.fn.attr"], "published": ["$.fn.comboVal"], "classes": [], "methods": [{"name": "comboVal", "description": "A method that allows getting or setting the selected value of a select (combo box) element, with an emphasis on accessibility. If called without arguments, it returns the current value of the first matched element. If called with a value argument, it sets that value across all matched elements."}, {"name": "AnonymousFunctiondbd9e7040100()", "scope": "$.fn.comboVal", "scopeKind": "function", "description": "unavailable"}, {"name": "AnonymousFunctiondbd9e7040200()", "scope": "", "scopeKind": "", "description": "unavailable"}], "calls": ["$.fn.children", "$.fn.val", "$.fn.prop", "$.fn.attr"], "search-terms": ["jQuery extension", "comboVal", "select element", "accessibility", "jQuery plugin"], "state": 2, "file_id": 7066, "knowledge_revision": 33716, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "AnonymousFunctiondbd9e7040100", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/webui-bwg/source/Styles/xb3/cmn/js/lib/jquery.ciscoExt.js", "pattern": "/^\t\tthis.each(function(){$/", "language": "JavaScript", "kind": "function", "signature": "()", "scope": "$.fn.comboVal", "scopeKind": "function"}, {"_type": "tag", "name": "AnonymousFunctiondbd9e7040200", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/webui-bwg/source/Styles/xb3/cmn/js/lib/jquery.ciscoExt.js", "pattern": "/^\t\t\t$this.ch