{"is_source_file": true, "format": "Shell script", "description": "This file is a shell script that manages transitioning a device from bridge mode to router mode, implementing configuration changes like modifying web interface settings, firewall rules, and Wi-Fi settings.", "external_files": ["/etc/iptables/default_rules.v4", "/etc/iptables/rules.v4", "/etc/dhcp_static_hosts", "/nvram/hostapd0.conf", "/nvram/hostapd1.conf", "/var/dnsmasq_orginal.conf", "/etc/dnsmasq.conf", "/etc/lighttpd.conf", "/lib/rdk/webgui.sh", "/lib/rdk/restore-wifi.sh", "/usr/bin/setup_routermode.sh"], "external_methods": ["dmcli"], "published": [], "classes": [], "methods": [], "calls": ["dmcli simu psmget dmsb.X_CISCO_COM_DeviceControl.LanManagementEntry.1.LanMode", "grep value", "cut -f3 -d :", "cut -f2 -d\" \"", "dmcli simu psmsetv dmsb.X_CISCO_COM_DeviceControl.LanManagementEntry.1.LanMode string router", "sed -i \"29 s/^#*//\" /nvram/hostapd0.conf", "cat /nvram/hostapd0.conf | grep ssid | head -1", "sed -i -e \"s/$DEFAULT_SSID/ssid=RDKB-EMU-2.4G/g\" /nvram/hostapd0.conf", "sed -i \"29 s/^#*//\" /nvram/hostapd1.conf", "cat /nvram/hostapd1.conf | grep ssid | head -1", "sed -i -e \"s/$DEFAULT_SSID/ssid=RDKB-EMU-5G/g\" /nvram/hostapd1.conf", "cp -fr /var/dnsmasq_orginal.conf /etc/dnsmasq.conf", "sed -i '$d' /etc/lighttpd.conf", "sh /lib/rdk/webgui.sh", "sh /lib/rdk/restore-wifi.sh", "cp /usr/bin/setup_routermode.sh /usr/bin/setup.sh"], "search-terms": ["BridgeMode", "restore-bridgemode", "LanMode", "WebUI", "dnsmasq", "hostapd", "lighttpd"], "state": 2, "file_id": 10286, "knowledge_revision": 36942, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "f955de3c60cf82d26d6ed11321bb6fe1", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/CcspWifiAgent/devices/scripts/Reset-Restore-Gateway/restore-bridgemode-to-routermode.sh", "revision_history": [{"36942": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}