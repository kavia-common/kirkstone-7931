{"is_source_file": true, "format": "C header file", "description": "This file defines the interface for a data manager module used for storing, retrieving, updating, and managing data elements and their associated triggers, options, and notifications in a system. It includes structure definitions, function prototypes for data operations, and mechanisms for asynchronous notifications.", "external_files": ["triggerMgr.h"], "external_methods": ["triggerMgr"], "published": ["DATA_MGR_get", "DATA_MGR_set", "DATA_MGR_set_unique", "DATA_MGR_get_unique", "DATA_MGR_del_unique", "DATA_MGR_get_next_iterator", "DATA_MGR_set_options", "DATA_MGR_get_runtime_values", "DATA_MGR_set_async_external_executable", "DATA_MGR_set_async_message_notification", "DATA_MGR_remove_async_notification", "DATA_MGR_init", "DATA_MGR_deinit", "DATA_MGR_show"], "classes": [], "methods": [{"name": "DATA_MGR_get", "description": "Retrieves the value of a specified data item into a buffer, returning a pointer to that buffer."}, {"name": "DATA_MGR_set", "description": "Sets the value of a specified data item and executes associated triggers if the value has changed."}, {"name": "DATA_MGR_set_unique", "description": "Creates or updates a unique data item with a generated name based on a seed, returning the name used."}, {"name": "DATA_MGR_get_unique", "description": "Retrieves the next data item in a namespace, returning its value and name."}, {"name": "DATA_MGR_del_unique", "description": "Deletes an element from a namespace based on an iterator."}, {"name": "DATA_MGR_get_next_iterator", "description": "Generates the next iterator for traversing elements in a namespace."}, {"name": "DATA_MGR_set_options", "description": "Sets option flags for a specific data item."}, {"name": "DATA_MGR_get_runtime_values", "description": "Performs string substitution on command-line arguments based on current data values."}, {"name": "DATA_MGR_set_async_external_executable", "description": "Sets up an asynchronous notification that executes an external program when a data element changes."}, {"name": "DATA_MGR_set_async_message_notification", "description": "Sets up an asynchronous notification that sends a message to a client when a data element changes."}, {"name": "DATA_MGR_remove_async_notification", "description": "Removes an asynchronous notification from a data element."}, {"name": "DATA_MGR_init", "description": "Initializes the data management system."}, {"name": "DATA_MGR_deinit", "description": "Deinitializes the data management system."}, {"name": "DATA_MGR_show", "description": "Outputs the current state of all data items to a file."}], "calls": ["triggerMgr"], "search-terms": ["data_element_t", "sysevent", "trigger_id", "async_notification", "set_unique", "get_unique", "data_mgr"], "state": 2, "file_id": 10955, "knowledge_revision": 37614, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "MIMIC_BROADCOM_RC", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/Utopia/source/sysevent/server/dataMgr.h", "pattern": "/^#define MIMIC_BROADCOM_RC /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "__DATA_MGR_H_", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/Utopia/source/sysevent/server/dataMgr.h", "pattern": "/^#define __DATA_MGR_H_$/", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "__anondff8a7700108", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/Utopia/source/sysevent/server/dataMgr.h", "pattern": "/^typedef struct {$/", "language": "C++", "kind": "struct"}, {"_type": "tag", "name": "__anondff8a7700208", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/Utopia/source/sysevent/server/dataMgr.h", "pattern": "/^typedef struct {$/", "language": "C++", "kind": "struct"}, {"_type": "tag", "name": "data_element_list_t", "pa