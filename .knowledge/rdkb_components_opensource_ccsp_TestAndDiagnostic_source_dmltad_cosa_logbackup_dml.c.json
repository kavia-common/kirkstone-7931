{"is_source_file": true, "format": "C", "description": "This file defines functions and variables related to log backup configuration via a set of APIs for getting, setting, validating, committing, and rolling back parameters. It includes functions for handling boolean and ulong parameters, interacts with system configuration via syscfg, and manages some internal state variables for enabling/disabling log backup and the interval setting.", "external_files": ["ansc_platform.h", "plugin_main_apis.h", "cosa_logbackup_dml.h", "safec_lib_common.h", "<syscfg/syscfg.h>"], "external_methods": ["syscfg_set_commit", "syscfg_set_u_commit", "syscfg_get", "syscfg_set_commit", "CcspTraceWarning", "SyncAndUploadLogs"], "published": ["LogBackup_GetParamBoolValue", "LogBackup_SetParamBoolValue", "LogBackup_GetParamUlongValue", "LogBackup_SetParamUlongValue", "LogBackup_Validate", "LogBackup_Commit", "LogBackup_Rollback", "get_logbackupcfg"], "classes": [], "methods": [{"name": "BOOL LogBackup_GetParamBoolValue(ANSC_HANDLE hInsContext,char * ParamName,BOOL * bValue)", "description": "Retrieves the boolean value of specified parameters, specifically 'X_RDKCENTRAL-COM_Enable' and 'X_RDKCENTRAL-COM_SyncandUploadLogs'.", "scope": "", "scopeKind": ""}, {"name": "BOOL LogBackup_SetParamBoolValue(ANSC_HANDLE hInsContext,char * ParamName,BOOL bValue)", "description": "Sets the boolean value of specified parameters, updating configuration for 'X_RDKCENTRAL-COM_Enable' and triggering log upload synchronization.", "scope": "", "scopeKind": ""}, {"name": "BOOL LogBackup_GetParamUlongValue(ANSC_HANDLE hInsContext,char * ParamName,ULONG * puLong)", "description": "Retrieves the unsigned long value for 'X_RDKCENTRAL-COM_Interval'.", "scope": "", "scopeKind": ""}, {"name": "BOOL LogBackup_SetParamUlongValue(ANSC_HANDLE hInsContext,char * ParamName,ULONG uValue)", "description": "Sets the unsigned long value for 'X_RDKCENTRAL-COM_Interval' and updates system configuration.", "scope": "", "scopeKind":