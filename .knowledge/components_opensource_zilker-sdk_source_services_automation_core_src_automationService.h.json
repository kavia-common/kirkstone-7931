{"is_source_file": true, "format": "C/C++ header", "description": "This file is a header file defining interfaces, data structures, macros, and constants for the Automation Service component of a larger project. It includes function prototypes for initializing, managing, and querying automation machines, which are state machines that process messages and change states accordingly. It also defines types and macros to support logging, verbosity levels, and licensing information.", "external_files": ["<stdbool.h>", "<icIpc/ipcStockMessagesPojo.h>", "<icTypes/icLinkedList.h>", "<icLog/logging.h>", "<cjson/cJSON.h>"], "external_methods": ["icLogDebug"], "published": ["automationServiceInitPhase1", "automationServiceInitPhase2", "automationServiceCleanup", "automationServiceRestore", "getMachineState", "automationServiceAddMachine", "automationServiceRemoveMachine", "automationServiceSetMachineEnabled", "automationServiceSetMachineSpecification", "automationServiceGetMachineInfos", "machineInfoFreeFunc"], "classes": [], "methods": [{"name": "automationServiceInitPhase1", "description": "Performs phase 1 of initialization, setting up necessary resources before IPC is enabled."}, {"name": "automationServiceInitPhase2", "description": "Performs phase 2 of initialization, preparing automations before execution."}, {"name": "automationServiceCleanup", "description": "Cleans up and terminates the Automation Service."}, {"name": "automationServiceRestore", "description": "Restores previously backed up automations from specified directories, restarting the service internally."}, {"name": "getMachineState", "description": "Retrieves the current state of a specific machine given its ID."}, {"name": "automationServiceAddMachine", "description": "Adds a new machine with the specified ID, specification, and enabled state to the service."}, {"name": "automationServiceRemoveMachine", "description": "Removes an existing machine identified by its ID, destroying resources."}, {"name": "aut