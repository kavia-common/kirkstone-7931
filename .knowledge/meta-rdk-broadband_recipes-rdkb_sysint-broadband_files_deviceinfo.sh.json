{"is_source_file": true, "format": "Shell script (bash/sh)", "description": "This file is a shell script named deviceinfo.sh that provides a command-line interface for retrieving various device information parameters such as model number, serial number, firmware version, MAC addresses, IP addresses, and configuration settings. It features a usage function, command-line argument parsing, and external command calls to system utilities like syscfg, grep, snmpget, ifconfig, and others to gather device-specific data.", "external_files": ["/tmp/factory_nvram.data", "/version.txt", "/etc/device.properties"], "external_methods": ["syscfg", "grep", "cut", "snmpget", "awk", "ifconfig", "sysevent", "psmcli"], "published": [], "classes": [], "methods": [{"name": "usage", "description": "Displays usage instructions and exits."}], "calls": ["syscfg get Device_Mode", "grep -a \"MODEL \" /tmp/factory_nvram.data", "grep -a \"Serial \" /tmp/factory_nvram.data", "grep \"imagename:\" /version.txt", "syscfg get mesh_state", "syscfg get mesh_url", "grep -a \"CM \" /tmp/factory_nvram.data", "grep PEER_INTERFACE /etc/device.properties", "snmpget -cpub -v2c -Ov $PEER_INTERFACE_IP ...", "ifconfig erouter0", "ifconfig brlan0", "syscfg get Device_Mode", "syscfg get mesh_enable", "psmcli get Device.DeviceInfo.X_RDK_RFC.Feature.OffChannelScan.Enable", "syscfg get eth_wan_enabled", "syscfg get mesh_optimized_mode", "syscfg get mwo_mqtt_config", "syscfg get offline_mqtt_broker", "syscfg get offline_mqtt_topic"], "search-terms": ["deviceinfo.sh", "shell script device information retrieval", "network configuration parameters", "SNMP and syscfg calls", "IP and MAC address extraction", "OffChannelScan feature"], "state": 2, "file_id": 43, "knowledge_revision": 26704, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "767c633e82410a4c81bf51c7c3ca9257", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "meta-rdk-broadband/recipes-rdkb/sysint-broadband/files/deviceinf