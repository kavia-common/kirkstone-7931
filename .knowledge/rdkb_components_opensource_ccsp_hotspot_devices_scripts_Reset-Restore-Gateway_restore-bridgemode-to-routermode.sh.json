{"is_source_file": true, "format": "shell script", "description": "This file is a shell script intended to switch a device from bridge mode to router mode, modifying network configurations, web UI settings, and services accordingly.", "external_files": ["/etc/iptables/default_rules.v4", "/etc/iptables/rules.v4", "/etc/dhcp_static_hosts", "/nvram/hostapd0.conf", "/nvram/hostapd1.conf", "/var/dnsmasq_orginal.conf", "/etc/lighttpd.conf", "/lib/rdk/webgui.sh", "/lib/rdk/restore-wifi.sh", "/usr/bin/setup_routermode.sh"], "external_methods": ["dmcli simu psmget", "dmcli simu psmsetv"], "published": [], "classes": [], "methods": [], "calls": ["dmcli simu psmget dmsb.X_CISCO_COM_DeviceControl.LanManagementEntry.1.LanMode", "dmcli simu psmsetv dmsb.X_CISCO_COM_DeviceControl.LanManagementEntry.1.LanMode string router", "sed -i '29 s/^.*/ssid=RDKB-EMU-2.4G/' /nvram/hostapd0.conf", "sed -i -e 's/.*ssida.*'/ssid=RDKB-EMU-2.4G/' /nvram/hostapd0.conf", "sed -i '29 s/^.*/ssid=RDKB-EMU-5G/' /nvram/hostapd1.conf", "sed -i -e 's/.*ssida.*'/ssid=RDKB-EMU-5G/' /nvram/hostapd1.conf", "cp -fr /var/dnsmasq_orginal.conf /etc/dnsmasq.conf", "sed -i '$d' /etc/lighttpd.conf", "sh /lib/rdk/webgui.sh", "sh /lib/rdk/restore-wifi.sh", "cp /usr/bin/setup_routermode.sh /usr/bin/setup.sh"], "search-terms": ["restore-bridgemode-to-routermode", "bridge-static", "network configuration", "device mode switch", "Wi-Fi setup", "dnsmasq", "lighttpd", "hostapd", "device control"], "state": 2, "file_id": 11488, "knowledge_revision": 38145, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "f955de3c60cf82d26d6ed11321bb6fe1", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/hotspot/devices/scripts/Reset-Restore-Gateway/restore-bridgemode-to-routermode.sh", "revision_history": [{"38145": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}