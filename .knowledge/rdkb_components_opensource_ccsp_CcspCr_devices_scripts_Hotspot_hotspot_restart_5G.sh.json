{"is_source_file": true, "format": "Shell script", "description": "This is a shell script used for restarting and managing 5G hotspot interfaces and services on a device. It includes commands to kill processes, reload kernel modules, restart network interfaces, and conditionally enable or disable hotspot features based on configuration values.", "external_files": ["/nvram/hostapd1.conf", "/nvram/hostapd4.conf", "/nvram/hostapd5.conf", "/nvram/hostapd0.conf", "/lib/rdk/handle_emu_gre.sh", "/usr/bin/dmcli"], "external_methods": ["ps", "grep", "awk", "xargs", "kill", "sleep", "rmmod", "modprobe", "ifconfig", "dmcli"], "published": [], "classes": [], "methods": [{"name": "Restart_Hostapd", "description": "Restarts the hostapd services for 5G interfaces by killing existing processes, reloading kernel modules, and restarting hostapd with specific configuration files."}], "calls": ["ps -eaf", "grep hostapd5", "grep hostapd1", "awk '{print $2}'", "xargs kill -9", "sleep 2", "rmmod rtl8812au", "modprobe rtl8812au", "modprobe 88x2bu", "ifconfig $INTERFACE_5G down", "sleep 3", "ifconfig $INTERFACE_5G up", "hostapd -B /nvram/hostapd5.conf", "hostapd -B /nvram/hostapd1.conf", "/lib/rdk/handle_emu_gre.sh create", "dmcli simu getv Device.DeviceInfo.X_COMCAST_COM_xfinitywifiEnable", "grep value", "cut -f3 -d :", "cut -f2 -d \" \"", "cat /nvram/hostapd4.conf", "cat /nvram/hostapd5.conf", "cat /nvram/hostapd0.conf", "grep -w interface", "grep bss", "[ \" $HOTSPOT_ENABLE \" = \" true \" ]", "[ \" $DONGLE_INDENTIFICATION \" = \" # \" ]", "/lib/rdk/handle_emu_gre.sh create", "echo \"CCSP-HOTSPOT IS SUCCESSFULLY RUNNING\"", "ifconfig $VIRTUAL_INTERFACE_2G down", "ifconfig $PUBLIC_INTERFACE_5G down", "ifconfig $PUBLIC_INTERFACE_2G down"], "search-terms": ["hotspot_restart_5G", "hostapd", "restart script", "5G interfaces", "kernel modules rtl8812au", "DONGLE_INDENTIFICATION", "xfinitywifiEnable", "handle_emu_gre.sh"], "state": 2, "file_id": 11577, "knowledge_revision": 38235, "git_revision