{"is_source_file": true, "format": "C header file", "description": "This file defines the interface and data structures for the Beep Client Session Object (BEEP CSO). It includes type definitions for function pointers representing the object's behavior, macros, and a class content structure that encapsulates state and functions related to a BEEP client session. The file is platform-independent and used as part of a larger framework for implementing BEEP sessions, providing interfaces for session management, environment setup, and page container handling.", "external_files": ["ansc_co_interface.h", "ansc_co_external_api.h"], "external_methods": [], "published": ["BEEP_CLIENT_SESSION_CLASS_CONTENT", "ACCESS_BEEP_CLIENT_SESSION_OBJECT"], "classes": [{"name": "BEEP_CLIENT_SESSION_OBJECT", "description": "Represents a BEEP client session with associated state and behavior function pointers."}], "methods": [{"name": "GetWebGeneralSession", "description": "Retrieves the general session handle associated with the BEEP client session."}, {"name": "SetWebGeneralSession", "description": "Sets the general session handle for the BEEP client session."}, {"name": "GetTimeout", "description": "Retrieves the session timeout value."}, {"name": "SetTimeout", "description": "Sets the session timeout value."}, {"name": "GetClientIdentifier", "description": "Retrieves the client identifier string."}, {"name": "SetClientIdentifier", "description": "Sets the client identifier string."}, {"name": "Reset", "description": "Resets the state of the session object."}, {"name": "Engage", "description": "Activates or starts the session."}, {"name": "Cancel", "description": "Cancels or terminates the session."}, {"name": "SetupEnv", "description": "Sets up the environment for the session."}, {"name": "CloseEnv", "description": "Closes or tears down the session environment."}, {"name": "GetPageContainer", "description": "Retrieves a page container by path."}, {"name": "AddPageContainer", "descriptio