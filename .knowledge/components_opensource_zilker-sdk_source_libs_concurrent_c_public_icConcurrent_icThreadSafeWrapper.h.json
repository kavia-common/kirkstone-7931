{"is_source_file": true, "format": "C header file", "description": "This header file defines a thread-safe wrapper for objects, providing concurrency primitives and management functions to safely handle objects across multiple threads. It includes type definitions for callback functions, data structures for wrapper instances, and function prototypes for assigning, releasing, reading, and modifying wrapped objects, as well as managing futures for asynchronous operations.", "external_files": ["<pthread.h>", "<stdbool.h>", "<stdint.h>"], "external_methods": [], "published": ["threadSafeWrapperAssignItem", "threadSafeWrapperAssignItemIfReleased", "threadSafeWrapperReleaseItem", "threadSafeWrapperConditionalReleaseItem", "threadSafeWrapperReadItem", "threadSafeWrapperEnqueueModification", "threadSafeWrapperModifyItem", "threadSafeWrapperDoNotFreeContextFunc", "threadSafeWrapperFutureInit", "threadSafeWrapperFutureDestroy", "threadSafeWrapperFutureAwait", "threadSafeWrapperFutureIsComplete", "threadSafeWrapperFutureIsApplied"], "classes": [], "methods": [{"name": "threadSafeWrapperAssignItem", "description": "Assigns an item to the wrapper, returning true if successful, false if an item is already assigned."}, {"name": "threadSafeWrapperAssignItemIfReleased", "description": "Assigns an item only if the wrapper has been released, using an atomic check-and-set mechanism."}, {"name": "threadSafeWrapperReleaseItem", "description": "Releases the currently assigned item, safe to call during concurrent reads."}, {"name": "threadSafeWrapperConditionalReleaseItem", "description": "Conditionally releases the item based on a check function, performed atomically."}, {"name": "threadSafeWrapperReadItem", "description": "Performs a read operation on the wrapped item using a callback."}, {"name": "threadSafeWrapperEnqueueModification", "description": "Enqueues a modification to be executed when there are no active readers."}, {"name": "threadSafeWrapperModifyItem", "description": "Performs a modification on the wrapped item once no readers are active, possibly blocking."}, {"name": "threadSafeWrapperDoNotFreeContextFunc", "description": "Utility function for contexts that do not require cleanup."}, {"name": "threadSafeWrapperFutureInit", "description": "Initializes a future for asynchronous modification operations."}, {"name": "threadSafeWrapperFutureDestroy", "description": "Cleans up a future once it is no longer needed."}, {"name": "threadSafeWrapperFutureAwait", "description": "Waits for a future to complete, with an optional timeout."}, {"name": "threadSafeWrapperFutureIsComplete", "description": "Checks if a future has completed."}, {"name": "threadSafeWrapperFutureIsApplied", "description": "Checks if the applied operation in a future has been completed."}], "search-terms": ["icThreadSafeWrapper", "threadSafeWrapperAssignItem", "concurrent wrapper", "thread safety", "async modification", "future handling", "lock-free", "multithreading"], "state": 2, "file_id": 1659, "knowledge_revision": 28318, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "THREAD_SAFE_WRAPPER_FUTURE_INIT", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/components/opensource/zilker-sdk/source/libs/concurrent/c/public/icConcurrent/icThreadSafeWrapper.h", "pattern": "/^#define THREAD_SAFE_WRAPPER_FUTURE_INIT /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "THREAD_SAFE_WRAPPER_INIT", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/components/opensource/zilker-sdk/source/libs/concurrent/c/public/icConcurrent/icThreadSafeWrapper.h", "pattern": "/^#define THREAD_SAFE_WRAPPER_INIT(/", "language": "C++", "kind": "macro", "signature": "(autoAssignFuncArg,autoReleaseCheckFuncArg,destroyItemFuncArg)"}, {"_type": "tag", "name": "ThreadSafeWrapperDestroyContextFunc", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/components/opensource/zilker-sdk/source/libs/concurrent/c/public/