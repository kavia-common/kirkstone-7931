{"is_source_file": true, "format": "shell script", "description": "A shell script for restarting 5G hotspot services and configuring network interfaces based on certain conditions. It includes commands to kill processes, load/unload kernel modules, restart hostapd, and manage network interfaces based on hotspot enablement status.", "external_files": ["/nvram/hostapd1.conf", "/nvram/hostapd4.conf", "/nvram/hostapd0.conf", "/lib/rdk/handle_emu_gre.sh"], "external_methods": ["cat", "grep", "head", "cut", "ps", "kill", "rmmod", "modprobe", "ifconfig", "sleep", "hostapd", "dmcli"], "published": [], "classes": [], "methods": [{"name": "Restart_Hostapd", "description": "Restarts the hostapd service for 5G interface by killing existing processes, reloading kernel modules, and restarting hostapd instances."}], "calls": ["ps -eaf", "grep hostapd5", "grep hostapd1", "awk '{print $2}'", "xargs kill -9", "rmmod rtl8812au", "modprobe rtl8812au", "modprobe 88x2bu", "ifconfig $INTERFACE_5G down", "sleep 3", "ifconfig $INTERFACE_5G up", "hostapd -B /nvram/hostapd5.conf", "hostapd -B /nvram/hostapd1.conf", "dmcli simu getv Device.DeviceInfo.X_COMCAST_COM_xfinitywifiEnable", "grep value", "cut -f3 -d :", "cut -f2 -d\" \"", "cat /nvram/hostapd4.conf", "cat /nvram/hostapd5.conf", "cat /nvram/hostapd0.conf", "grep -w interface", "grep bss", "cut -d '=' -f2", "cut -c1", "/lib/rdk/handle_emu_gre.sh create", "echo", "ifconfig $VIRTUAL_INTERFACE_2G down", "ifconfig $PUBLIC_INTERFACE_5G down", "ifconfig $PUBLIC_INTERFACE_2G down"], "search-terms": ["Hotspot", "hostapd", "network restart", "5G interface", "nvram configuration", "shell script hotspot restart"], "state": 2, "file_id": 6581, "knowledge_revision": 33239, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "27857a3590f6904f23202a232d3ff91d", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/generic/CcspLogAgent/devices/scripts/Hotspot/hotspot_restart_5G.sh", "revision_history": [{