{"is_source_file": true, "format": "Shell script (sh)", "description": "This file is a shell script used to control and manage a CPU process analyzer. It provides functions to start, stop, and optionally upload logs of the CPU analyzer tool based on the device type and user input.", "external_files": ["/etc/device.properties", "/etc/log_timestamp.sh", "/rdklogger/uploadRDKBLogs.sh"], "external_methods": ["dmcli eRT getv", "grep", "awk", "sed", "date", "tar", "chmod", "rm", "mkdir", "nice", "sleep", "touch"], "published": [], "classes": [], "methods": [{"name": "man_usage", "description": "Displays usage instructions for the script."}, {"name": "getMacAddressOnly", "description": "Retrieves the MAC address of the WAN interface."}], "calls": ["dmcli eRT getv Device.X_RDK_WanManager.CurrentActiveInterface", "grep value", "awk '{print $NF}'", "ifconfig $WANINTERFACE", "grep 'HWaddr'", "sed 's/://g'", "nice -n 19 /usr/bin/cpuprocanalyzer", "touch /tmp/PROC_ANALYZER_ENABLE", "tar -X $PATTERN_FILE -cvzf /tmp/$dt/$MAC\"_CPAstats_\"$dt\".tgz\" /tmp/cpuprocanalyzer", "/rdklogger/uploadRDKBLogs.sh", "rm -rf /tmp/cpuprocanalyzer", "rm -rf /tmp/PROC_ANALYZER_ENABLE"], "search-terms": ["RunCPUProcAnalyzer.sh", "cpu process analyzer", "device.properties", "log upload script", "Box type HUB4 SR213 XB3", "WAN interface detection"], "state": 2, "file_id": 526, "knowledge_revision": 27183, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "ffce90d7b7a3a7532d721466a06c61c9", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdk/components/generic/cpuprocanalyzer/conf/RunCPUProcAnalyzer.sh", "revision_history": [{"27183": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}