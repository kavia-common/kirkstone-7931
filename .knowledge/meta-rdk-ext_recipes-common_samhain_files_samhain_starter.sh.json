{"is_source_file": true, "format": "sh (Shell script)", "description": "This file is a shell script that initializes and manages the startup sequence for the 'samhain' monitoring agent on a device. It performs environment checks, configuration adjustments based on RFCs, image versions, and device types, and sets up necessary directories and logs before starting the monitoring process.", "external_files": ["/etc/include.properties", "/etc/device.properties", "/lib/rdk/getRFC.sh", "/usr/bin/md5sum", "/usr/sbin/samhain", "/opt/md5_version.txt"], "external_methods": ["pidof", "md5sum"], "published": [], "classes": [], "methods": [], "calls": ["pidof samhain", "cut -d ' ' -f1 /opt/md5_version.txt", "/usr/bin/md5sum /version.txt", "sleep 180", "nice -n 30 /usr/sbin/samhain -t init", "md5sum /version.txt", "sed -i -e \"s|MountCheckActive.*|MountCheckActive = no|g\"", "sed -i -e \"s|PortCheckActive.*|PortCheckActive = no|g\"", "sed -i -e \"s|ProcessCheckActive.*|ProcessCheckActive = no|g\"", "sed -i -e \"s|LogmonActive.*|LogmonActive = no|g\"", "mount-copybind", "rm -rf /tmp/samhain", "mkdir -p /tmp/samhain", "touch /opt/logs/dropbear.log", "touch /opt/logs/messages.txt", "touch /opt/logs/webpavideo.log", "touch /opt/logs/tr69agent_SoapDebug.log", "touch /opt/logs/snmpd.log", "rm -f /tmp/samhain.pid", "touch /tmp/samhain-enabled"], "search-terms": ["samhain", "samhain.sh", "device.properties", "SSH", "monitoring agent", "IDS", "RFC_ENABLE_IDS", "image version", "configuration", "device type"], "state": 2, "file_id": 1947, "knowledge_revision": 28607, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "f9318ac397d229ff3a0f69cb58c111f1", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "meta-rdk-ext/recipes-common/samhain/files/samhain_starter.sh", "revision_history": [{"28607": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}