{"is_source_file": true, "format": "shell script", "description": "This script manages the restart and configuration of 5G hotspot services, including stopping existing hostapd processes, reloading kernel modules, restarting hostapd with specific configurations, and toggling interfaces based on hotspot enablement status.", "external_files": ["/nvram/hostapd1.conf", "/nvram/hostapd4.conf", "/nvram/hostapd0.conf", "/lib/rdk/handle_emu_gre.sh"], "external_methods": ["ps", "grep", "awk", "xargs", "kill", "sleep", "rmmod", "modprobe", "ifconfig", "hostapd"], "published": [], "classes": [], "methods": [{"name": "Restart_Hostapd", "description": "Restarts hostapd processes for 5G interface, reloads kernel modules, and toggles the interface state."}], "calls": ["ps -eaf", "grep hostapd5", "grep hostapd1", "awk '{print $2}'", "xargs kill -9", "rmmod rtl8812au", "modprobe rtl8812au", "modprobe 88x2bu", "ifconfig $INTERFACE_5G down", "ifconfig $INTERFACE_5G up", "hostapd -B /nvram/hostapd5.conf", "hostapd -B /nvram/hostapd1.conf", "dmcli simu getv Device.DeviceInfo.X_COMCAST_COM_xfinitywifiEnable", "cat /nvram/hostapd4.conf", "grep -w interface", "cut -d '=' -f2", "cat /nvram/hostapd5.conf", "cat /nvram/hostapd0.conf", "grep bss=", "cut -c1", "/lib/rdk/handle_emu_gre.sh create", "ifconfig $VIRTUAL_INTERFACE_2G down", "ifconfig $PUBLIC_INTERFACE_5G down", "ifconfig $PUBLIC_INTERFACE_2G down"], "search-terms": ["hotspot_restart_5G", "hostapd", "nvram", "5G interface", "handle_emu_gre.sh", "xfinitywifiEnable", "rtl8812au", "88x2bu"], "state": 2, "file_id": 6530, "knowledge_revision": 33187, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "27857a3590f6904f23202a232d3ff91d", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/generic/harvester/devices/scripts/Hotspot/hotspot_restart_5G.sh", "revision_history": [{"33187": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}