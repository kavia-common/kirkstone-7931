{"is_source_file": true, "format": "C", "description": "This file implements the advanced operation functions of the Http Webs Trans Object, including functions to open and close sessions, and acquire and release access to session objects. It defines methods such as HttpWstoOpen, HttpWstoClose, HttpWstoAcquireAccess, and HttpWstoReleaseAccess, and manages internal state related to HTTP web socket transactions.", "external_files": ["http_wsto_global.h"], "external_methods": ["PHTTP_SIMPLE_SERVER_OBJECT->GetProperty", "PHTTP_SIMPLE_SERVER_OBJECT->AcquireBmoReq", "PHTTP_SIMPLE_SERVER_OBJECT->AcquireBmoRep", "PHTTP_SIMPLE_SERVER_OBJECT->ReleaseBmoReq", "PHTTP_SIMPLE_SERVER_OBJECT->ReleaseBmoRep", "AnscAcquireLock", "AnscReleaseLock"], "published": ["HttpWstoOpen", "HttpWstoClose", "HttpWstoAcquireAccess", "HttpWstoReleaseAccess"], "classes": [], "methods": [{"name": "ANSC_STATUS HttpWstoOpen(ANSC_HANDLE hThisObject)", "description": "Enables session activities by initializing request and response objects, setting their interface references, IDs, and addresses, preparing the session for HTTP web socket transaction.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpWstoClose(ANSC_HANDLE hThisObject)", "description": "Disables session activities by releasing the request and response objects associated with the session.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpWstoAcquireAccess(ANSC_HANDLE hThisObject)", "description": "Acquires exclusive access to the session object by locking the internal access lock.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpWstoReleaseAccess(ANSC_HANDLE hThisObject)", "description": "Releases exclusive access to the session object by unlocking the internal access lock.", "scope": "", "scopeKind": ""}], "calls": ["pSimpleServer->GetProperty", "pSimpleServer->AcquireBmoReq", "pSimpleServer->AcquireBmoRep", "pSimpleServer->ReleaseBmoReq", "pSimpleServer->ReleaseBmoRep", "AnscAcquireLock", "AnscReleaseLock"], "search-terms": ["HttpWsto", "WebsTrans", "session activities", "HttpWebsTransObject", "HttpWstoOpen", "HttpWstoClose", "HttpWstoAcquireAccess", "HttpWstoReleaseAccess"], "state": 2, "file_id": 8678, "knowledge_revision": 35338, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "HttpWstoAcquireAccess", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/util_api/http/components/HttpWebsTrans/http_wsto_operation.c", "pattern": "/^HttpWstoAcquireAccess$/", "language": "C", "typeref": "typename:ANSC_STATUS", "kind": "function", "signature": "(ANSC_HANDLE hThisObject)"}, {"_type": "tag", "name": "HttpWstoClose", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/util_api/http/components/HttpWebsTrans/http_wsto_operation.c", "pattern": "/^HttpWstoClose$/", "language": "C", "typeref": "typename:ANSC_STATUS", "kind": "function", "signature": "(ANSC_HANDLE hThisObject)"}, {"_type": "tag", "name": "HttpWstoOpen", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/util_api/http/components/HttpWebsTrans/http_wsto_operation.c", "pattern": "/^HttpWstoOpen$/", "language": "C", "typeref": "typename:ANSC_STATUS", "kind": "function", "signature": "(ANSC_HANDLE hThisObject)"}, {"_type": "tag", "name": "HttpWstoReleaseAccess", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/rdkb/components/opensource/ccsp/CcspCommonLibrary/source/util_api/http/components/HttpWebsTrans/http_wsto_operation.c", "pattern": "/^HttpWstoReleaseAccess$/", "language": "C", "typeref": "typename:ANSC_STATUS", "kind": "function", "signature": "(ANSC_HANDLE hThisObject)"}], "hash": "bf2280f78141beb2e5c34a1b2d26e43f", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/CcspCommonLibrary/source/util_api/http/compo