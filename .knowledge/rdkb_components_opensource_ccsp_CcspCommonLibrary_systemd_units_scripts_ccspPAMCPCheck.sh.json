{"is_source_file": true, "format": "shell script", "description": "This script checks and configures captive portal settings based on device properties, WiFi configuration, and P&M status. It interacts with system configuration and device management utilities, and manages WiFi and SSH access settings.", "external_files": ["/etc/device.properties", "/var/tmp/networkresponse.txt"], "external_methods": ["syscfg get", "psmcli get", "cat", "find", "dmcli eRT setvalues", "grep", "sleep"], "published": [], "classes": [], "methods": [{"name": "checkCaptivePortal", "description": "Main function that checks WiFi configuration, network response, and P&M status to determine if captive portal should be enabled."}], "calls": ["syscfg get redirection_flag", "psmcli get eRT.com.cisco.spvtg.ccsp.Device.WiFi.NotifyWiFiChanges", "cat /var/tmp/networkresponse.txt", "find /tmp/ -name \"pam_initialized\"", "dmcli eRT setvalues Device.DeviceInfo.X_RDKCENTRAL-COM_ConfigureWiFi bool TRUE", "grep \"Execution succeed.\"", "sleep 2", "syscfg set mgmt_wan_sshaccess 1", "syscfg commit"], "search-terms": ["ccspPAMCPCheck", "captive portal", "WiFi configuration", "P&M", "device.properties", "networkresponse", "ssh access"], "state": 2, "filename": "rdkb/components/opensource/ccsp/CcspCommonLibrary/systemd_units/scripts/ccspPAMCPCheck.sh", "format-version": 4, "code-base-name": "https://github.com/kavia-common/kirkstone-7931.git:kavia-main", "knowledge_revision": 9150, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "revision_history": [{"9150": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}