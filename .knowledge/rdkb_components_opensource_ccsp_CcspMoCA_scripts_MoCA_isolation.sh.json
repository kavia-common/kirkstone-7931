{"is_source_file": true, "format": "sh", "description": "This script manages the network interface 'brlan10' for MoCA isolation, including interface creation, configuration, and restart of related services depending on device type and model. It performs checks for interface presence, waits for interface initialization, and conditionally restarts multicast proxy, firewall, and UPnP services.", "external_files": ["/etc/device.properties", "/usr/ccsp/lan_handler.sh", "/etc/utopia/service.d/service_mcastproxy.sh", "/lib/rdk/start-upnp-service", "/usr/ccsp/moca/smcroute.conf"], "external_methods": ["psmcli get", "ifconfig", "grep", "killall", "sysevent set", "pidof"], "published": [], "classes": [], "methods": [], "calls": ["psmcli get dmsb.l2net.HomeNetworkIsolation", "ifconfig", "grep brlan10", "sh /usr/ccsp/lan_handler.sh home_lan_isolation_enable", "sysevent set multinet-up 9", "killall igmpproxy", "killall MRD", "killall mcsender", "ifconfig brlan0:0 down", "sh /etc/utopia/service.d/service_mcastproxy.sh mcastproxy-restart", "sysevent set mcastproxy-restart", "MRD &", "mcsender -ibrlan0 -t3 239.255.255.250:1900 &", "sysevent set firewall-restart", "sleep 5", "sh /lib/rdk/start-upnp-service restart", "pidof xcal-device", "killall xcal-device", "pidof xdiscovery", "killall xdiscovery"], "search-terms": ["MoCA_isolation", "brlan10", "MoCABridge_up", "HomeNetworkIsolation", "lan_handler", "mcastproxy", "XBOX", "XF3", "TG4482A", "TG3482G"], "state": 2, "file_id": 11351, "knowledge_revision": 38005, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "344937342e19f916aa5d651dc4e0d8f7", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/CcspMoCA/scripts/MoCA_isolation.sh", "revision_history": [{"38005": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}