{"is_source_file": true, "format": "Shell script / sh", "description": "This script configures and manages a web server (lighttpd) including setting ports, security headers, SSL, and WiFi configurations, and handles starting/stopping the server.", "external_files": ["/etc/lighttpd.conf", "/nvram/bbhm_cur_cfg.xml"], "external_methods": ["pidof", "kill", "syscfg get", "syscfg set", "syscfg commit", "cat", "grep", "cut", "dmcli eRT getv", "dmcli eRT setvalues"], "published": [], "classes": [], "methods": [], "calls": ["pidof lighttpd", "/bin/kill", "syscfg get http_admin_port", "syscfg get mgmt_wan_httpport", "syscfg get mgmt_wan_httpport_ert", "syscfg get mgmt_wan_httpsport", "syscfg get bridge_mode", "cp /etc/lighttpd.conf /var", "syscfg get HTTPSecurityHeaderEnable", "syscfg set mgmt_wan_httpsport 8081", "syscfg commit", "syscfg get mgmt_wan_httpsport", "cat /nvram/bbhm_cur_cfg.xml", "grep Device.WiFi.Radio.SSID.1.SSID", "grep Device.WiFi.Radio.SSID.2.SSID", "grep Device.WiFi.Radio.SSID.1.Passphrase", "grep Device.WiFi.Radio.SSID.2.Passphrase", "dmcli eRT getv Device.WiFi.SSID.1.SSID", "dmcli eRT getv Device.WiFi.SSID.2.SSID", "dmcli eRT getv Device.WiFi.AccessPoint.1.Security.X_CISCO_COM_KeyPassphrase", "dmcli eRT getv Device.WiFi.AccessPoint.2.Security.X_CISCO_COM_KeyPassphrase", "ls /tmp/*walledgarden*", "dmcli eRT setvalues Device.DeviceInfo.X_RDKCENTRAL-COM_ConfigureWiFi bool TRUE", "lighttpd -f /var/lighttpd.conf"], "search-terms": ["lighttpd", "web server configuration", "WiFi configuration", "SSL setup", "port configuration", "syscfg", "walled garden", "configuration script"], "state": 2, "filename": "rdkb/components/opensource/ccsp/xb3/components/ccsp/webui/source/Styles/xb3/config/webgui.sh", "format-version": 4, "code-base-name": "https://github.com/kavia-common/kirkstone-7931.git:kavia-main", "knowledge_revision": 6627, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "revision_history": [{"6627": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}