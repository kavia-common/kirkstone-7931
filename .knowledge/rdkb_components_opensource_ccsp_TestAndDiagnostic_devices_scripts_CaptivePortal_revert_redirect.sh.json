{"is_source_file": true, "format": "shell script", "description": "This script reverts configurations related to captive portal redirection, modifies configuration files for lighttpd and dnsmasq, updates iptables rules, and restarts relevant services to disable captive portal mode.", "external_files": ["/etc/lighttpd.conf", "/etc/dnsmasq.conf", "/nvram/updated_captiveportal_redirectionrules", "/nvram/captivemode_enabled"], "external_methods": ["cat", "grep", "sed", "killall"], "published": [], "classes": [], "methods": [], "calls": ["cat /etc/lighttpd.conf", "grep captiveportal.php /etc/lighttpd.conf", "wc -l", "sed -i '$d' /etc/lighttpd.conf", "cat /etc/dnsmasq.conf", "grep address /etc/dnsmasq.conf", "sed -i \"/address=/d\" /etc/dnsmasq.conf", "iptables -t nat -D PREROUTING -i brlan0 -p udp --dport 53 -j DNAT --to 10.0.0.1", "iptables -t nat -D PREROUTING -i brlan0 -p tcp --dport 53 -j DNAT --to 10.0.0.1", "rm /nvram/updated_captiveportal_redirectionrules", "rm /nvram/captivemode_enabled", "killall lighttpd", "killall dnsmasq", "/usr/bin/dnsmasq &"], "search-terms": ["revert_redirect", "lighttpd", "dnsmasq", "iptables", "captive portal", "redirection rules", "shell script"], "state": 2, "file_id": 6855, "knowledge_revision": 33512, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "3c0e763b6e1bfe7a4bf36d4ed02d0de1", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/TestAndDiagnostic/devices/scripts/CaptivePortal/revert_redirect.sh", "revision_history": [{"33512": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}