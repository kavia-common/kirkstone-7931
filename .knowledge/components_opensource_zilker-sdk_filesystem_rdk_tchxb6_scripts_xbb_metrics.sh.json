{"is_source_file": true, "format": "shell script", "description": "A shell script that logs battery metrics by querying device information and status, and sets up a daily cron job to further log battery backup metrics.", "external_files": ["/rdklogs/logs/BatteryLog.txt.0", "/etc/cron/cron.daily/xbb_daily_metrics.sh", "/etc/cron/cron.daily/xbb_daily_metrics.sh"], "external_methods": ["dmcli", "awk", "date", "grep", "sed", "chmod"], "published": [], "classes": [], "methods": [], "calls": ["dmcli eRT getv Device.X_CISCO_COM_MTA.Battery.Installed", "dmcli eRT getv Device.X_CISCO_COM_MTA.Battery.PowerStatus", "dmcli eRT getv Device.DeviceInfo.X_RDKCENTRAL-COM_batteryBackup.", "awk '{if(/value:/) print $5}'", "date", "grep -o -E '(Device.DeviceInfo.X_RDKCENTRAL-COM_batteryBackup.*|value:(.)*)'", "sed ':a;N;$!ba;s/\\nvalue:\\s/:/g'", "chmod 700 /etc/cron/cron.daily/xbb_daily_metrics.sh"], "search-terms": ["BatteryLog", "dmcli", "Battery.Installed", "Battery.PowerStatus", "cron.daily", "BatteryMetrics", "batteryBackup"], "state": 2, "file_id": 998, "knowledge_revision": 27657, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "ef710110509a21275200694e73ebb85f", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "components/opensource/zilker-sdk/filesystem/rdk/tchxb6/scripts/xbb_metrics.sh", "revision_history": [{"27657": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}