{"is_source_file": true, "format": "shell script", "description": "This file is a shell script used to restart Wi-Fi hotspot services for 5G interfaces, managing hostapd processes, interfacing with system configurations, and toggling hotspot features.", "external_files": ["/nvram/hostapd1.conf", "/nvram/hostapd4.conf", "/nvram/hostapd0.conf", "/lib/rdk/handle_emu_gre.sh"], "external_methods": ["ps", "grep", "awk", "kill", "sleep", "rmmod", "modprobe", "ifconfig", "hostapd", "dmcli"], "published": [], "classes": [], "methods": [{"name": "Restart_Hostapd", "description": "Restarts hostapd processes for 5G interfaces, involving killing existing processes, reloading drivers, and restarting hostapd with configuration files."}], "calls": ["ps -eaf", "grep hostapd5", "grep hostapd1", "awk '{print $2}'", "xargs kill -9", "rmmod rtl8812au 88x2bu", "sleep 1", "modprobe rtl8812au", "modprobe 88x2bu", "ifconfig $INTERFACE_5G down", "ifconfig $INTERFACE_5G up", "hostapd -B /nvram/hostapd5.conf", "hostapd -B /nvram/hostapd1.conf", "dmcli simu getv Device.DeviceInfo.X_COMCAST_COM_xfinitywifiEnable", "grep value", "cut -f3 -d :", "cut -f2 -d \" \"", "cat /nvram/hostapd4.conf", "grep -w interface", "cut -d '=' -f2", "cat /nvram/hostapd5.conf", "cat /nvram/hostapd0.conf", "grep -w bss", "cut -d '=' -f2", "cut -c1", "/lib/rdk/handle_emu_gre.sh create", "echo \"CCSP-HOTSPOT IS SUCCESSFULLY RUNNING\"", "ifconfig $VIRTUAL_INTERFACE_2G down", "ifconfig $PUBLIC_INTERFACE_5G down", "ifconfig $PUBLIC_INTERFACE_2G down"], "search-terms": ["Hotspot restart script", "hostapd management", "5G interface control", "Wi-Fi radio restart", "ccsp hotspot", "nvram configuration", "shell script Wi-Fi", "guest wireless restart"], "state": 2, "file_id": 10273, "knowledge_revision": 36929, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "27857a3590f6904f23202a232d3ff91d", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/CcspWifiAgent/