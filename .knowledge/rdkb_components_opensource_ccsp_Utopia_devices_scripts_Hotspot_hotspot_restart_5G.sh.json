{"is_source_file": true, "format": "shell script", "description": "This file is a shell script designed for managing 5G hotspot restart procedures, including killing processes, reloading modules, toggling interfaces, and controlling the hotspot service based on configuration parameters.", "external_files": ["/nvram/hostapd1.conf", "/nvram/hostapd4.conf", "/nvram/hostapd0.conf", "/lib/rdk/handle_emu_gre.sh"], "external_methods": ["ps", "grep", "awk", "xargs", "kill", "sleep", "rmmod", "modprobe", "ifconfig", "dmcli"], "published": [], "classes": [], "methods": [{"name": "Restart_Hostapd", "description": "Kills existing hostapd processes for 5G, reloads wireless modules, and restarts hostapd with configuration files."}], "calls": ["ps -eaf", "grep hostapd5", "grep -v grep", "awk '{print $2}'", "xargs kill -9", "sleep 2", "grep hostapd1", "rmmod rtl8812au", "sleep 1", "modprobe rtl8812au", "sleep 1", "modprobe 88x2bu", "sleep 2", "ifconfig $INTERFACE_5G down", "sleep 3", "ifconfig $INTERFACE_5G up", "hostapd -B /nvram/hostapd5.conf", "sleep 2", "hostapd -B /nvram/hostapd1.conf", "/lib/rdk/handle_emu_gre.sh create", "dmcli simu getv Device.DeviceInfo.X_COMCAST_COM_xfinitywifiEnable", "grep value", "cut -f3 -d :", "cut -f2 -d\" \"", "cat /nvram/hostapd4.conf", "grep -w interface", "cut -d '=' -f2", "cat /nvram/hostapd5.conf", "cat /nvram/hostapd0.conf", "grep -w bss", "cut -d '=' -f2", "cut -c1"], "search-terms": ["hotspot restart", "hostapd", "5G wireless"], "state": 2, "file_id": 11288, "knowledge_revision": 37947, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "27857a3590f6904f23202a232d3ff91d", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/Utopia/devices/scripts/Hotspot/hotspot_restart_5G.sh", "revision_history": [{"37947": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}