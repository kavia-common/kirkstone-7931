{"is_source_file": true, "format": "Python", "description": "This file defines a class 'ProcessTree' which encapsulates functionalities for constructing, pruning, and analyzing process trees based on log data during system boot. It includes methods for merging processes, sorting, computing start/end times, and other process tree manipulations.", "external_files": [], "external_methods": [], "published": ["ProcessTree"], "classes": [{"name": "ProcessTree", "description": "Encapsulates the process tree constructed from boot log files, providing methods for building, pruning, sorting, and analyzing process structures."}], "methods": [{"name": "build(self)", "description": "Builds the process tree from the list of top-level processes.", "scope": "ProcessTree", "scopeKind": "class"}, {"name": "sort(self, process_subtree)", "description": "Sorts processes and their children by PID.", "scope": "ProcessTree", "scopeKind": "class"}, {"name": "num_nodes(self, process_list)", "description": "Counts total nodes (processes) in a process subtree.", "scope": "ProcessTree", "scopeKind": "class"}, {"name": "get_start_time(self, process_subtree)", "description": "Calculates the earliest start time in a process subtree.", "scope": "ProcessTree", "scopeKind": "class"}, {"name": "get_end_time(self, process_subtree)", "description": "Calculates the latest end time in a process subtree.", "scope": "ProcessTree", "scopeKind": "class"}, {"name": "get_max_pid(self, process_subtree)", "description": "Finds the maximum PID in a process subtree.", "scope": "ProcessTree", "scopeKind": "class"}, {"name": "update_ppids_for_daemons(self, process_list)", "description": "Adjusts PPID of daemon processes for systems with system services loaded via 'rc'.", "scope": "ProcessTree", "scopeKind": "class"}, {"name": "prune(self, process_subtree, parent)", "description": "Removes idle, short-lived, or irrelevant processes from the tree to simplify visualization.", "scope": "ProcessTree", "scopeKind": "class"