{"is_source_file": true, "format": "C", "description": "This file implements various functions related to handling HTTP message bodies, including retrieving sizes, appending buffers and files, copying data from/to internal buffers, clearing, and saving message bodies. It is part of the Http Message Body Object module within a broader HTTP implementation.", "external_files": ["http_mbo_global.h", "AnscAllocateBdo", "AnscFreeBdo", "AnscCopyMemory", "AnscOpenFile", "AnscCloseFile", "AnscWriteFile", "AnscAcquireLock", "AnscReleaseLock", "AnscQueueGetFirstEntry", "AnscQueueGetNextEntry", "AnscQueuePushEntry", "AnscQueuePopEntry", "ACCESS_ANSC_BUFFER_DESCRIPTOR", "AnscBdoGetBlockSize", "AnscBdoGetBlock", "AnscFreeBdo", "UNREFERENCED_PARAMETER"], "external_methods": ["AnscAllocateBdo", "AnscFreeBdo", "AnscCopyMemory", "AnscOpenFile", "AnscCloseFile", "AnscWriteFile", "AnscAcquireLock", "AnscReleaseLock", "AnscQueueGetFirstEntry", "AnscQueueGetNextEntry", "AnscQueuePushEntry", "AnscQueuePopEntry", "ACCESS_ANSC_BUFFER_DESCRIPTOR", "AnscBdoGetBlockSize", "AnscBdoGetBlock"], "published": ["HttpMboGetBodySize", "HttpMboGetBodySize2", "HttpMboGetTransferSize", "HttpMboGetEntitySize", "HttpMboGetArrivedSize", "HttpMboAppendBodyBdo", "HttpMboAppendBodyFile", "HttpMboClearBody", "HttpMboCopyBodyFrom", "HttpMboCopyBodyInto", "HttpMboSaveAsBody", "HttpMboSaveBodyAsFile"], "classes": [], "methods": [{"name": "ULONG HttpMboGetBodySize(ANSC_HANDLE hThisObject)", "description": "Retrieves the size of the HTTP message body based on internal entity size.", "scope": "", "scopeKind": ""}, {"name": "ULONG HttpMboGetBodySize2(ANSC_HANDLE hThisObject)", "description": "Calculates the total size of the message body, considering queued buffer descriptors or transfer size depending on mode.", "scope": "", "scopeKind": ""}, {"name": "ULONG HttpMboGetTransferSize(ANSC_HANDLE hThisObject)", "description": "Returns the transfer size of the message body, accounting for mode and queued buffers.", "scope": "", "scopeKind": ""}, {"name": "ULONG HttpMboGetEntitySize(ANSC_HANDLE hThisObject)", "description": "Gets the entity size by calling the internal GetTransferSize method.", "scope": "", "scopeKind": ""}, {"name": "ULONG HttpMboGetArrivedSize(ANSC_HANDLE hThisObject)", "description": "Returns the size of the arrived entity, similar to get entity size.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpMboAppendBodyBdo(ANSC_HANDLE hThisObject,ANSC_HANDLE hBdo)", "description": "Appends a buffer descriptor to the message body, updating sizes and queue accordingly.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpMboAppendBodyFile(ANSC_HANDLE hThisObject,char * pFileName,int iRangeFrom,int iRangeTo)", "description": "Stub function to append a file content to message body; not supported in current implementation.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpMboClearBody(ANSC_HANDLE hThisObject)", "description": "Clears all buffer descriptors from the message body, freeing resources and resetting sizes.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpMboCopyBodyFrom(ANSC_HANDLE hThisObject,PVOID buffer,PULONG pulSize)", "description": "Copies data from internal buffers into an external buffer, up to the size specified.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpMboCopyBodyInto(ANSC_HANDLE hThisObject,PVOID buffer,PULONG pulSize)", "description": "Copies data from an external buffer into internal message body buffers.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpMboSaveAsBody(ANSC_HANDLE hThisObject,PVOID buffer,ULONG ulSize)", "description": "Stores external buffer data as the message body, replacing current content.", "scope": "", "scopeKind": ""}, {"name": "ANSC_STATUS HttpMboSaveBodyAsFile(ANSC_HANDLE hThisObject,char * file_name,BOOL bFlushBody)", "description": "Saves the message body content to a specified file, optionally flushing buffers.", "scope": "", "scopeKind": ""}], "calls": ["AnscAc