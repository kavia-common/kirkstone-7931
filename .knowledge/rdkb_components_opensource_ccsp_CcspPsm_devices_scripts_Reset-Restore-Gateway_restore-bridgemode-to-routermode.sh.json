{"is_source_file": true, "format": "Shell script", "description": "This file is a shell script that changes device operation modes from bridge to router, updating configuration files, network settings, and restarting certain services.", "external_files": ["/etc/iptables/default_rules.v4", "/etc/iptables/rules.v4", "/etc/dhcp_static_hosts", "/nvram/hostapd0.conf", "/nvram/hostapd1.conf", "/var/dnsmasq_orginal.conf", "/etc/lighttpd.conf", "/lib/rdk/webgui.sh", "/lib/rdk/restore-wifi.sh", "/usr/bin/setup_routermode.sh"], "external_methods": ["dmcli", "grep", "cut", "sed", "cat", "touch", "cp", "rm", "sh"], "published": [], "classes": [], "methods": [], "calls": ["cp -fr /etc/iptables/default_rules.v4 /etc/iptables/rules.v4", "rm /etc/dhcp_static_hosts", "touch /etc/dhcp_static_hosts", "dmcli simu psmget dmsb.X_CISCO_COM_DeviceControl.LanManagementEntry.1.LanMode", "grep value", "cut -f3 -d :", "cut -f2 -d\" \"", "[ \"$BRIDGEMODE_ENABLE\" = \"bridge-static\" ]", "dmcli simu psmsetv dmsb.X_CISCO_COM_DeviceControl.LanManagementEntry.1.LanMode string router", "sed -i \"29 s/^#*//\" /nvram/hostapd0.conf", "cat /nvram/hostapd0.conf | grep ssid | head -1", "sed -i -e \"s/$DEFAULT_SSID/ssid=RDKB-EMU-2.4G/g\" /nvram/hostapd0.conf", "sed -i \"29 s/^#*//\" /nvram/hostapd1.conf", "cat /nvram/hostapd1.conf | grep ssid | head -1", "sed -i -e \"s/$DEFAULT_SSID/ssid=RDKB-EMU-5G/g\" /nvram/hostapd1.conf", "cp -fr /var/dnsmasq_orginal.conf /etc/dnsmasq.conf", "sed -i '$d' /etc/lighttpd.conf", "sh /lib/rdk/webgui.sh", "sh /lib/rdk/restore-wifi.sh", "cp /usr/bin/setup_routermode.sh /usr/bin/setup.sh"], "search-terms": ["BridgeMode", "restore-bridgemode", "dnsmasq", "hostapd", "dmcli", "RouterMode"], "state": 2, "file_id": 10794, "knowledge_revision": 37452, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "f955de3c60cf82d26d6ed11321bb6fe1", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/CcspPsm/devices/scripts/Reset-Restore-Gateway/restore-bridgemode-to-routermode.sh", "revision_history": [{"37452": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}