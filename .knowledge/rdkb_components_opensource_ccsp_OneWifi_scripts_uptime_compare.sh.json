{"is_source_file": true, "format": "shell scripting", "description": "This script compares system uptimes from two sources (`rpcclient` and `uptime`) and takes a restart action if the ARM uptime exceeds the atom uptime based on certain thresholds. It includes logic to parse uptime durations, extract days, hours, and minutes, and conditionally restart services.", "external_files": ["/etc/device.properties", "/usr/ccsp/ccsp_restart.sh"], "external_methods": ["cat", "grep", "cut", "awk", "tr", "rpcclient"], "published": [], "classes": [], "methods": [], "calls": ["cat /etc/device.properties", "grep ARM_ARPING_IP", "cut -f 2 -d=\"\"", "rpcclient $ARM_RPC_IP uptime", "grep load", "echo", "grep day", "awk -F, '{sub(\".*up \",x,$1);print $1}'", "awk -F, '{sub(\".*up \",x,$1);print $1}'", "grep \":\"", "tr -d \" \"", "cut -f1 -d:", "cut -f2 -d:", "uptime", "sh", "/usr/ccsp/ccsp_restart.sh"], "search-terms": ["uptime compare", "ARM uptime script", "system uptime monitoring", "ccsp restart automation", "uptime parsing shell"], "state": 2, "file_id": 10628, "knowledge_revision": 37284, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "b35843bb1af785df3574d166cf43d1bd", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/OneWifi/scripts/uptime_compare.sh", "revision_history": [{"37284": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}