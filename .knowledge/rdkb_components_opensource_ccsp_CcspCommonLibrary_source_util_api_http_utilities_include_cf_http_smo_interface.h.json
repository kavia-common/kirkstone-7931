{"is_source_file": true, "format": "C/C++ header file", "description": "This header file defines an interface for Content Filtering HTTP Session Management Object (SMO), including structures, constants, function pointer types, and the class content used for managing HTTP sessions within a content filtering system.", "external_files": ["ansc_co_interface.h", "ansc_co_external_api.h"], "external_methods": [], "published": ["AddSession", "RemoveSession", "ResumeSession", "TerminateSession", "BlockSession", "GetSession", "GetID", "GetReqUri", "ClearSessionTable", "SetContext", "CreateTimer", "RemoveTimer", "StartTimer", "StopTimer", "SetLogFile"], "classes": [{"name": "CF_HTTP_SMO_OBJECT", "description": "Encapsulates the internal state and methods for managing HTTP sessions within the Content Filtering system, including session list, lock, context, timer, and logging."}], "methods": [{"name": "AddSession", "description": "Adds a new HTTP session to the management object, associating transaction and message objects."}, {"name": "RemoveSession", "description": "Removes an existing HTTP session based on the transaction record."}, {"name": "ResumeSession", "description": "Resumes a paused or blocked session identified by its ID."}, {"name": "TerminateSession", "description": "Terminates an active session given its ID."}, {"name": "BlockSession", "description": "Blocks a session, setting an error code for the session."}, {"name": "GetSession", "description": "Retrieves a session entity by its ID."}, {"name": "GetID", "description": "Provides the next available session ID."}, {"name": "GetReqUri", "description": "Retrieves the request URI associated with a transaction record and message."}, {"name": "ClearSessionTable", "description": "Clears all session entries in the session table."}, {"name": "SetContext", "description": "Sets the operational context for the session management object."}, {"name": "CreateTimer", "description": "Creates a timer resource for session manageme