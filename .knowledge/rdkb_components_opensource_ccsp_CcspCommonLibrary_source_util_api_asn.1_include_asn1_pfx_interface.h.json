{"is_source_file": true, "format": "C header file (ASN.1 interface definitions)", "description": "This file defines ASN.1 data structures and function pointer types related to PKCS#12 components, including classes for PFX, MACData, SafeContents, SafeBag, and various key and certificate bags. It serves as an interface for ASN.1 encoding/decoding and cryptographic operations used in PKCS#12 implementation.", "external_files": ["asn1_pfx_interface.h (itself, as a header include)", "other ASN.1 related headers/libraries used for ASN.1 handling", "cryptographic libraries used for MAC and encryption operations"], "external_methods": ["GetVersion", "GetAuthSafe", "GetMacData", "HmacAuthenticate", "DecryptContent", "EncryptAndSign", "EnumerateInfo", "AddCertificate", "AddCertAndKeyInfo", "LookforKeyInfoBag", "GetCertObject", "IsCertBag", "IsKeyInfoBag", "GetLocalKeyIDObj", "GetValueHandle", "SetLocalKeyID", "SetCertInfo", "SetKeyInfo"], "published": ["ANSC_ASN1_PFX", "ANSC_ASN1_MACDATA", "ANSC_ASN1_AUTHENTICATEDSAFE", "ANSC_ASN1_SAFECONTENTS", "ANSC_ASN1_SAFEBAG", "ANSC_ASN1_PKCS12ATTRIBUTES", "ANSC_ASN1_PKCS12ATTRIBUTE", "ANSC_ASN1_KEYBAG", "ANSC_ASN1_PKCS8SHROUDEDKEYBAG", "ANSC_ASN1_CERTBAG", "ANSC_ASN1_CERTVALUE", "ANSC_ASN1_CRLBAG", "ANSC_ASN1_CRLVALUE", "ANSC_ASN1_SECRETBAG", "ANSC_ASN1_BAGVALUE"], "classes": [{"name": "ANSC_ASN1_PFX", "description": "Represents the ASN.1 PFX sequence structure used for PKCS#12 PFX data, including version, authSafe, macData, and associated cryptographic actions."}, {"name": "ANSC_ASN1_MACDATA", "description": "Represents the MAC Data ASN.1 structure containing digest info, salt, and iterations for integrity verification."}, {"name": "ANSC_ASN1_AUTHENTICATEDSAFE", "description": "Represents the ASN.1 structure for the authenticated safe, a sequence of ContentInfo objects."}, {"name": "ANSC_ASN1_SAFECONTENTS", "description": "Sequence of SafeBag objects representing safe contents in PKCS#12."}, {"name": "ANSC_ASN1_SAFEBAG", "description": "Sequence structure representing a safe bag which can store keys, certificates, or secrets, with associated attributes and methods."}, {"name": "ANSC_ASN1_PKCS12ATTRIBUTES", "description": "Set of PKCS#12 attributes attached to safe bags."}, {"name": "ANSC_ASN1_PKCS12ATTRIBUTE", "description": "Attribute object in PKCS#12, used for additional info."}, {"name": "ANSC_ASN1_KEYBAG", "description": "Structure encapsulating a private key (PrivateKeyInfo)."}, {"name": "ANSC_ASN1_PKCS8SHROUDEDKEYBAG", "description": "Encrypted private key info structure."}, {"name": "ANSC_ASN1_CERTBAG", "description": "Sequence representing a certificate bag, with methods to retrieve the certificate object."}, {"name": "ANSC_ASN1_CERTVALUE", "description": "Choice type representing a certificate value, either base64 encoded or binary."}, {"name": "ANSC_ASN1_CRLBAG", "description": "Sequence representing a CRL bag."}, {"name": "ANSC_ASN1_CRLVALUE", "description": "Octet string holding CRL data."}, {"name": "ANSC_ASN1_SECRETBAG", "description": "Sequence representing a secret (e.g., symmetric key, password secret)."}, {"name": "ANSC_ASN1_BAGVALUE", "description": "Choice object encapsulating various bag content types (key, cert, CRL, secret, safe content)."}], "methods": [{"name": "GetVersion", "description": "Retrieves the version number of the PFX structure."}, {"name": "GetAuthSafe", "description": "Accesses the authenticated safe content info."}, {"name": "GetMacData", "description": "Accesses the MAC data for integrity verification."}, {"name": "HmacAuthenticate", "description": "Performs HMAC-based authentication over content."}, {"name": "DecryptContent", "description": "Decrypts encrypted content within the structure."}, {"name": "EncryptAndSign", "description": "Encrypts content and signs it."}, {"name": "EnumerateInfo", "description": "Iterates over certificates and keys in the store."}, {"name": "AddCertificate", "description": "Adds a certificate to the PKCS#12 structure."}, {"