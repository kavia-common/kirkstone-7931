{"is_source_file": true, "format": "shell script", "description": "This script automates the restoration of default Wi-Fi settings, including SSID, passwords, channels, and configurations, for various Wi-Fi interfaces on a device. It reads configuration files, updates SSID and security settings, updates PSM configurations, and disables Wi-Fi interfaces as part of a reset or restore process.", "external_files": ["/nvram/hostapd0.conf", "/nvram/hostapd1.conf", "/nvram/hostapd4.conf", "/nvram/hostapd5.conf"], "external_methods": ["grep", "cut", "sed", "hostapd_cli", "dmcli"], "published": [], "classes": [], "methods": [], "calls": ["grep", "cut", "sed", "hostapd_cli -i <interface> SET ssid <ssid>", "hostapd_cli -i <interface> SET wpa_passphrase <password>", "hostapd_cli -i <interface> SET channel <channel>", "hostapd_cli -i <interface> DISABLE", "dmcli simu psmsetv <parameters>"], "search-terms": ["restore-wifi", "hostapd.conf", "WiFi reset", "SSID restore", "channel configuration", "wpa_passphrase", "hostapd_cli", "PSM", "Wifi interface"], "state": 2, "file_id": 10288, "knowledge_revision": 36943, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "a12052677f2b1672475e100d7b1e6e25", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/CcspWifiAgent/devices/scripts/Reset-Restore-Gateway/restore-wifi.sh", "revision_history": [{"36943": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}