{"is_source_file": true, "format": "Python", "description": "This file contains the implementation of self-test cases for various image features in a Yocto Project-based build environment. It defines a class 'ImageFeatures' with multiple test methods to verify SSH connectivity, Wayland support, bmap creation, hypervisor formats, image chaining, image types, user addition, busybox configuration, debug filesystem generation, and empty image creation.", "external_files": ["oeqa.selftest.case", "oeqa.core.decorator", "oeqa.utils.commands", "oeqa.utils.sshcontrol"], "external_methods": ["OESelftestTestCase", "OETestTag", "runCmd", "bitbake", "get_bb_var", "runqemu"], "published": ["ImageFeatures"], "classes": [{"name": "ImageFeatures", "description": "A collection of self-test cases to verify various features and functionalities of Yocto images."}], "methods": [{"name": "test_non_root_user_can_connect_via_ssh_without_password(self)", "description": "Verifies that non-root users can connect via SSH without a password in a built image.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_all_users_can_connect_via_ssh_without_password(self)", "description": "Checks that all specified users can connect via SSH without passwords, and that root cannot.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_wayland_support_in_image(self)", "description": "Checks if Wayland support is present in the image and if the image can be built with Wayland.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_bmap(self)", "description": "Verifies that bmap support is enabled and working correctly, and that images are sparse and valid gzip files.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_hypervisor_fmts(self)", "description": "Tests support for various hypervisor image formats and verifies their properties with qemu-img.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_long_chain_conversion(self)", "description": "Verifies chaining multiple conversion commands and generating a sha256 checksum.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_image_fstypes(self)", "description": "Ensures images of different filesystem types can be built and are present in the deployment directory.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_useradd_static(self)", "description": "Tests static user addition extension in the build configuration.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_no_busybox_base_utils(self)", "description": "Ensures busybox is replaced with core utils as specified in the configuration.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_image_gen_debugfs(self)", "description": "Verifies debug filesystem generation, extraction, and presence of debug symbols.", "scope": "ImageFeatures", "scopeKind": "class"}, {"name": "test_empty_image(self)", "description": "Tests creation of an empty image with no packages and verifies its manifest is empty.", "scope": "ImageFeatures", "scopeKind": "class"}], "calls": ["oeqa.utils.commands.runCmd", "oeqa.utils.commands.bitbake", "oeqa.core.decorator.OETestTag", "oeqa.selftest.case.OESelftestTestCase", "oeqa.utils.sshcontrol.SSHControl", "oeqa.utils.commands.get_bb_var", "oeqa.utils.commands.runqemu"], "search-terms": ["ImageFeatures", "ssh connection tests", "Wayland support", "bmap support", "hypervisor image formats", "image conversion chaining", "image filesystem types", "useradd extension", "busybox replacement", "debugfs generation", "empty image creation"], "state": 2, "file_id": 2440, "knowledge_revision": 29098, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "ctags": [{"_type": "tag", "name": "ImageFeatures", "path": "/home/kavia/workspace/code-generation/kirkstone-7931/openembedded-core/meta/lib/oeqa/selftest/cases/imagefeatures.py", "pattern": "/^class ImageFeatures(OESelftestTestCase):$/", "language": "Python", "kind": "class"}, {"_type"