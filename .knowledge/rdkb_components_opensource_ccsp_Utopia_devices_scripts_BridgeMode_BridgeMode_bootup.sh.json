{"is_source_file": true, "format": "shell script", "description": "This script configures network settings related to bridge mode on a device, managing interfaces, DHCP settings, and network configurations based on the device's bridge mode status.", "external_files": ["/nvram/hostapd0.conf", "/nvram/hostapd1.conf", "/var/dnsmasq_org.conf"], "external_methods": ["dmcli"], "published": [], "classes": [], "methods": [], "calls": ["dmcli simu getv Device.X_CISCO_COM_DeviceControl.LanManagementEntry.1.LanMode", "grep value", "cut -f3 -d :", "cut -f2 -d\" \"", "cat /nvram/hostapd0.conf", "grep -w interface", "head -1", "cut -d '=' -f2", "cat /nvram/hostapd1.conf", "brctl delif brlan0 $INTERFACE_2G", "brctl delif brlan0 $INTERFCAE_5G", "ifconfig $INTERFACE_2G down", "ifconfig $INTERFCAE_5G down", "echo \"0\" > /tmp/Get2gssidEnable.txt", "echo \"0\" > /tmp/Get5gssidEnable.txt", "cat /var/dnsmasq_org.conf", "grep dhcp-range", "cut -d ',' -f1", "cut -d '=' -f2", "cut -d '.' -f1-3", "ip addr add $LAN_IP.1/24 dev eth0", "ip addr add 192.168.100.1/24 dev eth0", "killall dnsmasq", "/sbin/udhcpc -ieth2"], "search-terms": ["BridgeMode_bootup", "network configuration script", "device bridge mode setup", "dmcli network", "hostapd configuration", "lan management"], "state": 2, "file_id": 11293, "knowledge_revision": 37949, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "4aa8f2a0b2f3893452ef554a762e1613", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/Utopia/devices/scripts/BridgeMode/BridgeMode_bootup.sh", "revision_history": [{"37949": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}