{"is_source_file": true, "format": "shell script", "description": "This file is a shell script designed to reset and restore Wi-Fi settings on a device. It reads current configuration values from specific config files, modifies SSID, password, and channel settings to default or specified values, updates configuration via command line interfaces, and disables Wi-Fi interfaces as part of the reset process.", "external_files": ["/nvram/hostapd0.conf", "/nvram/hostapd1.conf", "/nvram/hostapd4.conf", "/nvram/hostapd5.conf"], "external_methods": ["grep", "cut", "sed", "hostapd_cli", "dmcli", "sleep", "cat"], "published": [], "classes": [], "methods": [], "calls": ["grep interface=", "cut -d '='", "head -n1", "head -1", "sed -i", "hostapd_cli -i", "dmcli simu psmsetv", "sleep 5", "sleep 10", "cat /nvram/hostapd0.conf", "cat /nvram/hostapd4.conf", "cat /nvram/hostapd5.conf"], "search-terms": ["restore-wifi.sh", "Wi-Fi reset script", "hostapd configuration", "nvram", "deactivate wifi interfaces"], "state": 2, "file_id": 6876, "knowledge_revision": 33532, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "a12052677f2b1672475e100d7b1e6e25", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/TestAndDiagnostic/devices/scripts/Reset-Restore-Gateway/restore-wifi.sh", "revision_history": [{"33532": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}