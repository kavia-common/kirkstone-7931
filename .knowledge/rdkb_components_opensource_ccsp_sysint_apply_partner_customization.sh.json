{"is_source_file": true, "format": "shell script", "description": "A shell script that applies partner customization by reading device properties, updating system configuration files, and logging the process.", "external_files": ["/etc/log_timestamp.sh", "/etc/device.properties"], "external_methods": ["source", "echo_t", "syscfg set", "syscfg commit", "sync"], "published": [], "classes": [], "methods": [], "calls": ["source /etc/log_timestamp.sh", "echo_t \"Partner customization - START\"", "echo $PARTNER_ID", "echo_t \"Partner customization - applying partner_id from device.properties: $partner_id \"", "echo_t \"Partner customization - updating /nvram/.partner_ID with value: $partner_id \"", "echo $partner_id > /nvram/.partner_ID", "syscfg set PartnerID \"$partner_id\"", "syscfg commit", "sync", "echo_t \"Partner customization - COMPLETED\"", "echo_t \"Partner customization - FAILED. PartnerID is null from device.properties\"", "echo_t \"Partner customization - FAILED. device.properties is missing\""], "search-terms": ["apply_partner_customization", "partner_id", "device.properties", "syscfg", "log_timestamp", "Consolelog.txt", "bash script", "partner customization"], "state": 2, "file_id": 12449, "knowledge_revision": 39104, "git_revision": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf", "hash": "d0e9da5961006110b02eea96920c4144", "format-version": 4, "code-base-name": "kirkstone-7931", "filename": "rdkb/components/opensource/ccsp/sysint/apply_partner_customization.sh", "revision_history": [{"39104": "7e30f88c4ca54db6e79d70eb5e919c86fb3e3bcf"}]}