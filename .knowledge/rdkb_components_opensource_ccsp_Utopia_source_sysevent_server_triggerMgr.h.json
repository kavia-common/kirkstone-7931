{"is_source_file": true, "format": "C header file", "description": "This file defines data structures, enumerations, and function declarations for managing triggers and actions in a system. It includes types for trigger actions, triggers, trigger lists, and function prototypes for creating, removing, executing, and managing triggers and their associated actions. The focus is on maintaining trigger lists and executing associated actions when triggers change state.", "external_files": ["pthread.h", "sysevent/sysevent.h"], "external_methods": [], "published": ["TRIGGER_MGR_print_trigger_list_t", "TRIGGER_MGR_set_flags", "TRIGGER_MGR_remove_actions", "TRIGGER_MGR_remove_action", "TRIGGER_MGR_remove_trigger", "TRIGGER_MGR_add_executable_call_action", "TRIGGER_MGR_add_notification_message_action", "TRIGGER_MGR_remove_notification_message_actions", "TRIGGER_MGR_execute_trigger_actions", "TRIGGER_MGR_get_cloned_action", "TRIGGER_MGR_free_cloned_action", "TRIGGER_MGR_init", "TRIGGER_MGR_deinit"], "classes": [], "methods": [{"name": "TRIGGER_MGR_print_trigger_list_t", "description": "Prints the current list of triggers and notifications (debug function)."}, {"name": "TRIGGER_MGR_set_flags", "description": "Sets specified flags on a trigger identified by target_id or trigger_id."}, {"name": "TRIGGER_MGR_remove_actions", "description": "Removes all actions owned by a specified owner for a given trigger."}, {"name": "TRIGGER_MGR_remove_action", "description": "Removes a specific action from a trigger based on trigger and action IDs and owner."}, {"name": "TRIGGER_MGR_remove_trigger", "description": "Removes an entire trigger and its actions."}, {"name": "TRIGGER_MGR_add_executable_call_action", "description": "Adds an action that executes an external program when a trigger fires."}, {"name": "TRIGGER_MGR_add_notification_message_action", "description": "Adds an action that sends a notification message when a trigger fires."}, {"name": "TRIGGER_MGR_remove_notification_message_act